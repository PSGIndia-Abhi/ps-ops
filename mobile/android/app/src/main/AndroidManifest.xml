<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Visit start requires a one-time precise location read to satisfy the
         backend's 100m geofence check (PATCH /api/visits/:id/start). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Job update photos: camera capture. Gallery selection deliberately does NOT declare
         READ_MEDIA_IMAGES/READ_EXTERNAL_STORAGE - react-native-image-picker's launchImageLibrary
         (v8.x) already uses Android's system Photo Picker for this, which needs no storage
         permission at all. Declaring those broad permissions when the picker satisfies the same
         use case is exactly what Play Store's Photo and Video Permissions policy rejects apps
         for ("use alternative system pickers for the photos/videos"). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- CRM New Lead: "pick a number from contacts" (read-only; nothing is written to contacts). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Job update voice notes: microphone recording. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Reminders (meetings, follow-ups, tasks, payments): the alarm before something is due and
         the popup when something is set for you. POST_NOTIFICATIONS is asked at runtime (Android 13+).
         SCHEDULE_EXACT_ALARM lets the alarm ring on the minute (the person can allow it in
         "Alarms & reminders"; without it Android may deliver a few minutes late). The boot
         permission re-arms reminders after a restart. USE_FULL_SCREEN_INTENT shows the alarm over
         the lock screen where Android allows it; elsewhere it falls back to a heads-up banner. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Declaring CAMERA/ACCESS_FINE_LOCATION above makes Android's manifest
         merger auto-add these as required="true" hardware features unless
         overridden here - which would make Play Store reject the app as
         "incompatible" on any phone whose camera lacks autofocus or that
         has no dedicated GPS chip (network-based location still works fine
         for this app's needs), even though nothing here actually requires
         either capability specifically. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Reminders: AlarmManager delivers here; also the Snooze / Dismiss buttons. -->
      <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
      <!-- Re-arms reminders after a reboot, an app update, or the exact-alarm switch changing. -->
      <receiver android:name=".reminders.ReminderBootReceiver" android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
